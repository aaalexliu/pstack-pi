#!/bin/sh
# screen-lock run KEY -- <command> [args...]
# Runs the command while it holds this Mac's screen, so leads take turns with it. It waits for the screen,
# wakes the display, keeps it awake while the command runs, and frees the screen when the command ends.
# The lock is a kernel file lock (lockf) on an open file that the command and its children inherit, so the
# screen stays held while any of them runs, and frees itself when the last one ends, however it ends:
# no lock goes stale. The lock file names its last holder. SCREEN_LOCK overrides its path, for tests.
if [ $# -lt 4 ] || [ "$1" != run ] || [ "$3" != -- ]; then
  echo 'usage: screen-lock run KEY -- <command> [args...]' >&2
  exit 64
fi
key=$2
shift 3
lock=${SCREEN_LOCK:-/tmp/screen.lock}
exec 9>>"$lock" || exit 73
if ! lockf -s -t 0 9; then
  echo "screen-lock: $key waits for the screen, held by $(cat "$lock"); lsof $lock lists what has it open" >&2
  # macOS lockf busy-loops on flock when it waits on an fd, burning a core, so poll once a second instead.
  until lockf -s -t 0 9; do sleep 1; done
fi
echo "$key since $(date "+%-I:%M %p %Z")" >"$lock"
exec caffeinate -du -- "$@"
