{
  "name": "@aaalexliu/pstack-pi",
  "version": "0.1.0",
  "type": "module",
  "description": "Eight reviewed pstack skills for Pi, generated from pinned Cursor sources.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaalexliu/pstack-pi.git"
  },
  "keywords": [
    "pi-package",
    "pstack"
  ],
  "engines": {
    "node": ">=22.19.0",
    "pi": "0.85.1"
  },
  "pi": {
    "extensions": ["extensions/subagent/index.ts"],
    "skills": [
      "skills/bro/SKILL.md",
      "skills/principle-boundary-discipline/SKILL.md",
      "skills/principle-encode-lessons-in-structure/SKILL.md",
      "skills/principle-type-system-discipline/SKILL.md",
      "skills/tdd/SKILL.md",
      "skills/technical-writing/SKILL.md",
      "skills/typescript-best-practices/SKILL.md",
      "skills/unslop/SKILL.md"
    ],
    "prompts": [],
    "themes": []
  },
  "files": [
    "LICENSE",
    "README.md",
    "package.json",
    "agents/general-purpose.md",
    "extensions/subagent/agents.ts",
    "extensions/subagent/domain.ts",
    "extensions/subagent/index.ts",
    "extensions/subagent/runner.ts",
    "skills/bro/SKILL.md",
    "skills/principle-boundary-discipline/SKILL.md",
    "skills/principle-encode-lessons-in-structure/SKILL.md",
    "skills/principle-type-system-discipline/SKILL.md",
    "skills/tdd/SKILL.md",
    "skills/technical-writing/SKILL.md",
    "skills/typescript-best-practices/SKILL.md",
    "skills/typescript-best-practices/references/patterns.md",
    "skills/unslop/SKILL.md"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run sync:check && npm run check:content && npm test",
    "check:content": "node scripts/check-content.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:sync && npm run test:content && npm run test:subagent && npm run test:pi",
    "test:subagent": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/subagent/*.test.mjs",
    "test:content": "node --test tests/content/*.test.mjs",
    "test:sync": "node --test tests/sync/*.test.mjs",
    "test:pi": "node --test tests/pi/smoke.test.mjs",
    "sync": "node scripts/sync-upstream.mjs sync snapshot vendor/cursor-pstack . sync/manifest.json sync/upstream.lock.json",
    "sync:check": "node scripts/sync-upstream.mjs check snapshot vendor/cursor-pstack . sync/manifest.json sync/upstream.lock.json",
    "sync:relock": "node scripts/sync-upstream.mjs relock . sync/manifest.json"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "22.19.19",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true },
    "typebox": { "optional": true }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "yaml": "2.9.0"
  }
}
