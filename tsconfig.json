{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "checkJs": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "lib": ["ES2023"],
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*.mjs", "tests/**/*.mjs", "extensions/**/*.ts"]
}
